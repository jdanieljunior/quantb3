# QuantB3 — Variáveis de Ambiente (NUNCA commitar o .env real)
# Copie este arquivo para .env e preencha os valores

# Banco de dados (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# E-mail (Brevo ou Resend)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=sua_api_key_aqui
EMAIL_FROM=quantb3@seudominio.com
EMAIL_TO=voce@seudominio.com

# Autenticação do Dashboard (hash SHA256 da senha)
DASHBOARD_PASSWORD_HASH=hash_sha256_da_sua_senha

# Ambiente
ENV=production
