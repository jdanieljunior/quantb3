# Streamlit Secrets — EXEMPLO
# Copie para .streamlit/secrets.toml e preencha os valores
# NUNCA commitar o arquivo real

# Banco de dados (Supabase)
DATABASE_URL = "postgresql://postgres:[SENHA]@db.[PROJETO].supabase.co:5432/postgres"

# Telegram
TELEGRAM_BOT_TOKEN = "seu_bot_token"
TELEGRAM_CHAT_ID = "seu_chat_id"

# E-mail
EMAIL_PROVIDER = "brevo"
EMAIL_API_KEY = "sua_api_key"
EMAIL_FROM = "quantb3@seudominio.com"
EMAIL_TO = "voce@seudominio.com"

# Autenticação do dashboard
# Gere o hash com: python -c "import hashlib; print(hashlib.sha256('SUA_SENHA'.encode()).hexdigest())"
DASHBOARD_PASSWORD_HASH = "hash_sha256_da_sua_senha_aqui"

# Login opcional com GitHub OAuth
# Crie um OAuth App em GitHub > Settings > Developer settings > OAuth Apps.
# Homepage URL: https://quantb3-joaodaniel.streamlit.app
# Authorization callback URL: https://quantb3-joaodaniel.streamlit.app/
# Use um valor aleatório longo para GITHUB_OAUTH_STATE_SECRET.
# Mantenha o Client Secret e este arquivo real fora do Git.
GITHUB_OAUTH_CLIENT_ID = "seu_client_id"
GITHUB_OAUTH_CLIENT_SECRET = "seu_client_secret"
GITHUB_OAUTH_STATE_SECRET = "gere_um_segredo_aleatorio_longo"
GITHUB_OAUTH_REDIRECT_URI = "https://quantb3-joaodaniel.streamlit.app/"
GITHUB_OAUTH_ALLOWED_LOGINS = "jdanieljunior"
